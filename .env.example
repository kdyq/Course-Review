# 数据库
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@127.0.0.1:5432/course_review?schema=public"
DATABASE_URL_TEST="postgresql://postgres:YOUR_PASSWORD@127.0.0.1:5432/course_review_test?schema=public"

# Better Auth
BETTER_AUTH_SECRET="replace-with-a-long-random-string"
BETTER_AUTH_URL="http://127.0.0.1:3000"

# Redis（可选，未启动时回退到内存限流）
REDIS_URL="redis://127.0.0.1:6379"

# QQ 邮箱 SMTP
QQ_SMTP_HOST="smtp.qq.com"
QQ_SMTP_PORT="465"
QQ_SMTP_SECURE="true"
QQ_SMTP_USER="YOUR_QQ_EMAIL"
QQ_SMTP_PASS="YOUR_QQ_AUTH_CODE"
EMAIL_FROM="YOUR_QQ_EMAIL"

# 邮件投递模式：log 只写日志不发信；smtp 真实发送
# smtp 真实发送；log 只写服务端日志，适合不发信的本地测试
EMAIL_DELIVERY_MODE="smtp"
# 本地开发默认不要求邮箱验证
EMAIL_VERIFICATION_ENABLED="false"

# 本地默认关闭新账号冷却和 PENDING 审核，E2E 测试时显式打开
REVIEW_MODERATION_ENABLED="false"

# 本地种子管理员，只用于开发
ADMIN_USERNAME="guo"
ADMIN_PASSWORD="123456"
ADMIN_EMAIL="guo@local.invalid"

NODE_ENV="development"
